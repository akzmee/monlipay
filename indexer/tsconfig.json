{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    ".ponder/generated/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    // These files import virtual modules (ponder:indexer, ponder:db, ponder:api,
    // ponder:schema) that are only generated by `ponder dev` / `ponder build`.
    // Typecheck them by running `ponder dev` once — Ponder will report any
    // type errors in these files via its own tsc invocation.
    "src/index.ts",
    "src/api/index.ts"
  ]
}

