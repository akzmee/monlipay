# ============================================
# MAINNET configuration — tracked in git (no secrets)
# ============================================
# To use: cp .env.mainnet .env.local
# Then add your LIFI_API_KEY and ALCHEMY_API_KEY to .env.local

# --- Network ---
# Force mainnet mode
NEXT_PUBLIC_NETWORK=mainnet

