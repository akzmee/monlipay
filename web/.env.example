# ============================================
# MonliPay Environment Variables (MAINNET branch)
# ============================================
# Copy this file to .env.local and fill in your values.
# This branch is configured for Monad Mainnet (chain ID 143).

# --- Contract ---
# Address of the deployed LinkVault.sol contract on Monad Mainnet.
# Live since July 2026 — verify on Monadscan:
# https://monadscan.com/address/0xf7B6aE721d5C851A2269A675Ee43D60c3E34F9c9
# Testnet reference (chain ID 10143): 0xEB9a0BC1c7518F839B8F249E407A1AfC011E0aB3
NEXT_PUBLIC_LINK_VAULT_ADDRESS=0xd7846DC6Fd8c159cF59957c532173d828f7B5BBC

# --- Network Selection ---
# Force mainnet mode on this branch.
NEXT_PUBLIC_NETWORK=mainnet

# --- WalletConnect ---
# Required for the RainbowKit wallet modal to work.
# Get a free project ID at https://cloud.walletconnect.com
# NEXT_PUBLIC_WC_PROJECT_ID=

# ============================================
# BRIDGE FEATURE (Server-side only — NO NEXT_PUBLIC_ prefix!)
# ============================================
# The /bridge page is OPTIONAL. The core payment-link flow works without it.
# To enable cross-chain bridging into Monad, get free keys from:

# LI.FI API Key — bridge route aggregator
# Get a free key at https://li.fi
# This key is used ONLY in /api/bridge/* routes (server-side).
# NEVER add NEXT_PUBLIC_ prefix — that would expose it in the browser.
# LIFI_API_KEY=

# Alchemy API Key — multi-chain balance scanning
# Get a free key at https://alchemy.com
# This key is used ONLY in /api/bridge/balance (server-side).
# NEVER add NEXT_PUBLIC_ prefix.
# ALCHEMY_API_KEY=
