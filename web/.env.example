# ============================================
# MonliPay Environment Variables (MAINNET branch)
# ============================================
# Copy this file to .env.local and fill in your values.
# This branch is configured for Monad Mainnet (chain ID 143).

# --- Contract ---
# Address of the deployed LinkVault.sol contract on Monad Mainnet.
# Live since July 2026 — verify on Monadscan:
# https://monadscan.com/address/0xd7846DC6Fd8c159cF59957c532173d828f7B5BBC
# Testnet reference (chain ID 10143): 0x90978783cb701AEe7896975B43ecd37e0B4819DC
NEXT_PUBLIC_LINK_VAULT_ADDRESS=0xd7846DC6Fd8c159cF59957c532173d828f7B5BBC

# --- Network Selection ---
# Force mainnet mode on this branch.
NEXT_PUBLIC_NETWORK=mainnet

# --- WalletConnect ---
# Required for the RainbowKit wallet modal to work.
# Get a free project ID at https://cloud.walletconnect.com
# NEXT_PUBLIC_WC_PROJECT_ID=

# ============================================
# GAS SPONSOR (EIP-2771 meta-transactions)
# ============================================
# When enabled, the app relays `claim()` txs through an ERC2771Forwarder so
# the recipient pays no gas. The sponsor wallet (server-side) pays instead.
# Disable at any time — the UI falls back to direct user-paid claim.

# Client-visible flag. Set to "true" to expose the sponsored-claim path.
NEXT_PUBLIC_GAS_SPONSOR_ENABLED=false

# The ERC2771Forwarder contract that the deployed LinkVault V2 trusts.
# Set by scripts/deploy-mainnet.sh when the forwarder is deployed.
# NEXT_PUBLIC_GAS_FORWARDER_ADDRESS=

# Sponsor wallet private key (SERVER-ONLY — never use NEXT_PUBLIC_ prefix).
# Fund this wallet with MON before enabling sponsorship.
# GAS_SPONSOR_PRIVATE_KEY=

# Max MON the sponsor will spend per UTC day (default: "0.5").
# GAS_SPONSOR_DAILY_BUDGET_MON=0.5

# ============================================
# INDEXER (Ponder — see /indexer)
# ============================================
# Base URL of the Ponder indexer that indexes LinkVault events.
# When unset, the My Links page shows empty and auto-refund is a no-op
# (manual refund per LinkCard still works).
# The indexer is chain-agnostic — one instance indexes both mainnet + testnet.
# NEXT_PUBLIC_INDEXER_URL=https://indexer.monlipay.xyz

# ============================================
# BRIDGE FEATURE (Server-side only — NO NEXT_PUBLIC_ prefix!)
# ============================================
# The /bridge page is OPTIONAL. The core payment-link flow works without it.
# To enable cross-chain bridging into Monad, get free keys from:

# LI.FI API Key — bridge route aggregator
# Get a free key at https://li.fi
# This key is used ONLY in /api/bridge/* routes (server-side).
# NEVER add NEXT_PUBLIC_ prefix — that would expose it in the browser.
# LIFI_API_KEY=

# Alchemy API Key — multi-chain balance scanning
# Get a free key at https://alchemy.com
# This key is used ONLY in /api/bridge/balance (server-side).
# NEVER add NEXT_PUBLIC_ prefix.
# ALCHEMY_API_KEY=
