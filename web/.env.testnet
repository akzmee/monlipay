# ============================================
# TESTNET configuration — tracked in git (no secrets)
# ============================================
# To use: cp .env.testnet .env.local
# Then add your LIFI_API_KEY and ALCHEMY_API_KEY to .env.local

# --- Network ---
# Force testnet mode
NEXT_PUBLIC_NETWORK=testnet

# --- Contract ---
# LinkVault contract on Monad Testnet
NEXT_PUBLIC_LINK_VAULT_ADDRESS=0xEB9a0BC1c7518F839B8F249E407A1AfC011E0aB3
