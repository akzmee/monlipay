# =============================================================================
# .env.deploy.example — template for VPS deployment secrets
# =============================================================================
#
# Copy to .env on the VPS and fill in real values.
# Use docker compose --env-file .env to provide build args and secrets.
#
#   cp .env.deploy.example .env
#   nano .env  # fill in values
#
# IMPORTANT: NEVER commit .env to git. It contains real API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# WalletConnect (shared by both instances)
# -----------------------------------------------------------------------------
# Get a free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here

# Optional Privy email onboarding. Allow both public app origins in its dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only Envio HyperSync token for public Group Payment activity.
ENVIO_API_TOKEN=

# -----------------------------------------------------------------------------
# Contract addresses (already deployed on each chain)
# -----------------------------------------------------------------------------
# LinkVault on Monad Testnet (chain ID 10143)
TESTNET_LINK_VAULT_ADDRESS=0xEB9a0BC1c7518F839B8F249E407A1AfC011E0aB3

# LinkVault on Monad Mainnet (chain ID 143)
# Replace with your real mainnet contract address after running:
#   forge script script/DeployLinkVault.s.sol --rpc-url https://rpc.monad.xyz ...
MAINNET_LINK_VAULT_ADDRESS=0xf7B6aE721d5C851A2269A675Ee43D60c3E34F9c9

# -----------------------------------------------------------------------------
# Bridge feature (server-side only, safe to leave blank if no bridge)
# -----------------------------------------------------------------------------
# LI.FI API key — https://li.fi
LIFI_API_KEY=

# Alchemy API key (multi-chain balance scan) — https://alchemy.com
ALCHEMY_API_KEY=

# Enable only when the relay key, budget, and trusted forwarder are configured.
NEXT_PUBLIC_GAS_SPONSOR_ENABLED=false

# Ponder schema. Use a new name when an incompatible indexing build needs
# its own tables; retain/back up the previous schema before switching.
PONDER_DATABASE_SCHEMA=monlipay

# Lucky Link deployments (set after deployment, then rebuild frontend)
TESTNET_LUCKY_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_LUCKY_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
TESTNET_APP_ORIGIN=https://testnet.monlipay.xyz
MAINNET_APP_ORIGIN=https://monlipay.xyz

# Equal group payment deployments
TESTNET_GROUP_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_GROUP_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
